[Unit]
Description=Moliris Maintenance Webapp (SRS v1.0)
Documentation=https://github.com/moliris/maintenance-webapp
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=moliris
Group=moliris
WorkingDirectory=/opt/moliris/Moliris_Maintenance_Webapp_SRS
EnvironmentFile=/etc/moliris/moliris.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/backend/server.js
Restart=on-failure
# RestartSec=5 definisce l'intervallo di attesa prima del riavvio del processo da parte di systemd;
# NON costituisce una garanzia di ripristino del servizio entro 5 secondi (il tempo effettivo dipende
# dai tempi di bootstrap di Node.js, dall'inizializzazione delle connessioni MongoDB e dal riaggancio rete).
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moliris-webapp

# Hardening di sicurezza Linux/systemd (RNF-SEC-001..009)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moliris/server-fs
ReadOnlyPaths=/etc/moliris /opt/moliris/Moliris_Maintenance_Webapp_SRS
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Limiti risorse (RNF-PERF-003, RNF-REL-005)
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
